[Unit]
Description=Hermes Shared Browser - Xvfb display
After=network.target
PartOf=hermes-browser.target

[Service]
Type=simple
Environment=HERMES_BROWSER_CONFIG=@CONFIG@
ExecStart=/usr/bin/python3 @RUNTIME@ launch xvfb
UMask=0077
Restart=always
RestartSec=2

[Install]
WantedBy=hermes-browser.target
