[Unit]
Description=Hermes Shared Browser - x11vnc bridge
After=hermes-browser-xvfb.service
Wants=hermes-browser-xvfb.service
PartOf=hermes-browser.target hermes-browser-xvfb.service

[Service]
Type=simple
Environment=HERMES_BROWSER_CONFIG=@CONFIG@
ExecStart=/usr/bin/python3 @RUNTIME@ launch vnc
UMask=0077
Restart=always
RestartSec=2

[Install]
WantedBy=hermes-browser.target
