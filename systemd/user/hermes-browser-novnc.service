[Unit]
Description=Hermes Shared Browser - noVNC web bridge
After=hermes-browser-vnc.service
Wants=hermes-browser-vnc.service
PartOf=hermes-browser.target hermes-browser-vnc.service

[Service]
Type=simple
Environment=HERMES_BROWSER_CONFIG=@CONFIG@
ExecStart=/usr/bin/python3 @RUNTIME@ launch novnc
UMask=0077
Restart=always
RestartSec=2

[Install]
WantedBy=hermes-browser.target
