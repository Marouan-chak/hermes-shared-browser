[Unit]
Description=Hermes Shared Browser - Chromium with local CDP
After=hermes-browser-xvfb.service
Wants=hermes-browser-xvfb.service
PartOf=hermes-browser.target hermes-browser-xvfb.service

[Service]
Type=simple
Environment=HERMES_BROWSER_CONFIG=@CONFIG@
ExecStart=/usr/bin/python3 @RUNTIME@ launch chromium
UMask=0077
KillMode=mixed
TimeoutStopSec=30
Restart=always
RestartSec=3

[Install]
WantedBy=hermes-browser.target
